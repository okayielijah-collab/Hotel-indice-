# Public-read Supabase project settings. Keep these as server runtime variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Optional legacy alternative: SUPABASE_ANON_KEY=your-legacy-anon-jwt

# Optional: enables AI-written, grounded recommendation explanations.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini
